  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"nickname\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "game_roles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"game_roles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"account_id\" TEXT NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"game\" TEXT NOT NULL, \"uid\" TEXT NOT NULL, \"server\" TEXT NOT NULL, \"nickname\" TEXT NOT NULL, \"level\" INTEGER NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), UNIQUE (\"account_id\", \"game\", \"uid\"));"
        }
      ]
    },
    {
      "name": "note_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_snapshots\" (\"role_id\" INTEGER NOT NULL REFERENCES game_roles (id) ON DELETE CASCADE, \"game\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"fetched_at\" TEXT NOT NULL, PRIMARY KEY (\"role_id\"));"
        }
      ]
    },
    {
      "name": "check_in_history",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"check_in_history\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"account_id\" TEXT NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"game\" TEXT NOT NULL, \"day\" TEXT NOT NULL, \"result\" TEXT NOT NULL, \"reward\" TEXT NULL, \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "widget_configs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"widget_configs\" (\"widget_id\" INTEGER NOT NULL, \"size\" TEXT NOT NULL, \"account_id\" TEXT NULL REFERENCES accounts (id) ON DELETE SET NULL, \"role_id\" INTEGER NULL REFERENCES game_roles (id) ON DELETE SET NULL, \"theme\" TEXT NOT NULL, \"opacity\" REAL NOT NULL DEFAULT 0.8, \"accent\" TEXT NOT NULL DEFAULT 'match', \"font_size\" TEXT NOT NULL, \"visible_items\" TEXT NOT NULL DEFAULT '[]', \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"widget_id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"dynamic_color\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dynamic_color\" IN (0, 1)), \"accent\" TEXT NOT NULL DEFAULT 'lime', \"locale_code\" TEXT NULL, \"onboarding_seen\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_seen\" IN (0, 1)), \"auto_check_in_minutes\" INTEGER NOT NULL DEFAULT 1200, \"auto_check_in_games\" TEXT NOT NULL DEFAULT 'genshin,starRail,zzz,hi3', \"notification_settings\" TEXT NOT NULL DEFAULT '{}', \"refresh_interval_minutes\" INTEGER NOT NULL DEFAULT 30, PRIMARY KEY (\"id\"));"
        }
      ]
    },
